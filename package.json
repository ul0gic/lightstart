{
  "name": "@lightstart/light",
  "version": "0.1.0",
  "description": "Light-DOM web components from object definitions, with reactive properties, a tagged-template renderer, signals, property types, a theme engine and a component library.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/light"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "light-dom",
    "signals",
    "renderer",
    "ui",
    "framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "light": "./bin/light.js"
  },
  "exports": {
    ".": {
      "types": "./view/types.d.ts",
      "default": "./view/index.js"
    },
    "./view/core": "./view/core.js",
    "./dom": {
      "types": "./dom/types.d.ts",
      "default": "./dom/index.js"
    },
    "./markup": "./markup/index.js",
    "./markup/core": "./markup/core.js",
    "./native/tui": "./native/tui/index.js",
    "./native/desktop": "./native/desktop/index.js",
    "./html": {
      "types": "./html/types.d.ts",
      "default": "./html/index.js"
    },
    "./html/core": "./html/core.js",
    "./signals": {
      "types": "./signals/types.d.ts",
      "default": "./signals/index.js"
    },
    "./types": "./types/types.js",
    "./env": {
      "types": "./env/types.d.ts",
      "default": "./env/index.js"
    },
    "./navigation": {
      "types": "./navigation/types.d.ts",
      "default": "./navigation/index.js"
    },
    "./theme": {
      "types": "./theme/types.d.ts",
      "default": "./theme/index.js"
    },
    "./theme/tokens": "./theme/tokens.js",
    "./theme/terminal": "./theme/terminal.js",
    "./theme/baked": "./theme/baked.js",
    "./theme/classes": {
      "types": "./theme/classes/types.d.ts",
      "default": "./theme/classes/index.js"
    },
    "./theme/palette": "./theme/classes/palette.js",
    "./theme/runtime": {
      "types": "./theme/runtime-types.d.ts",
      "default": "./theme/runtime.js"
    },
    "./check": {
      "types": "./check/types.d.ts",
      "default": "./check/define.js"
    },
    "./eslint": {
      "types": "./eslint/types.d.ts",
      "default": "./eslint/index.js"
    },
    "./controller": {
      "types": "./controller/types.d.ts",
      "default": "./controller/index.js"
    },
    "./controller/resource": "./controller/resource.js",
    "./controller/storage": "./controller/adapters/storage.js",
    "./controller/document": "./controller/adapters/document.js",
    "./controller/url": "./controller/adapters/url.js",
    "./controller/view": "./controller/view.js",
    "./controller/class": "./controller/class.js",
    "./model": {
      "types": "./model/types.d.ts",
      "default": "./model/index.js"
    },
    "./model/store": "./model/store.js",
    "./model/adapter": "./model/adapter.js",
    "./model/indexeddb": "./model/indexeddb.js",
    "./model/jsonl": "./model/jsonl.js",
    "./model/sql": "./model/sql.js",
    "./model/sql-builder": "./model/sql-builder.js",
    "./model/binder": "./model/binder.js",
    "./model/slug": "./model/slug.js",
    "./model/events": "./model/events.js",
    "./html/constants.js": "./html/constants.js",
    "./html/parser.js": "./html/parser.js",
    "./html/values.js": "./html/values.js",
    "./html/host.js": "./html/host.js",
    "./html/template.js": "./html/template.js",
    "./html/parts.js": "./html/parts.js",
    "./html/reactive.js": "./html/reactive.js",
    "./html/core.js": "./html/core.js",
    "./html/tokenizer.js": "./html/tokenizer.js",
    "./signals/index.js": "./signals/index.js",
    "./signals/store.js": "./signals/store.js",
    "./view/core.js": "./view/core.js",
    "./*": "./*"
  },
  "peerDependencies": {
    "@lightstart/server": "^0.1.0",
    "@lightstart/sqlite": "^0.1.0",
    "@stylistic/eslint-plugin": "^2.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^15.14.0",
    "typescript": "^6.0.3 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@lightstart/server": {
      "optional": true
    },
    "@lightstart/sqlite": {
      "optional": true
    },
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-lit": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "scriptc"
    ]
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.css",
    "native/desktop/ffi.ts",
    "native/desktop/shim/**"
  ]
}
